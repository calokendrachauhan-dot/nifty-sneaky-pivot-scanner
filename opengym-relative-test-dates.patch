   fs.writeFileSync(path.join(dir, 'state-' + uid + '.json'), JSON.stringify(S));
 }
 
+/* The sample history sits a week back from today, not on fixed dates: the coach only reads the
+   last MAX_WEEKS of training, so a hardcoded date eventually falls out of the window. */
+export function day(offset = 0) {
+  const d = new Date(); d.setDate(d.getDate() - 7 + offset);
+  return d.toISOString().slice(0, 10);
+}
+
 /** A profile that has consented and has some history — the usual starting point. */
 export function sampleState(over = {}) {
   return {
@@ -68,10 +75,10 @@ export function sampleState(over = {}) {
